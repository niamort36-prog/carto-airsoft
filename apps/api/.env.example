# Copier ce fichier en `.env` et remplir les valeurs. Ne jamais committer `.env`.

# Serveur HTTP
PORT=3000

# PostgreSQL + PostGIS (docker compose up -d à la racine du repo)
DATABASE_URL=postgres://carto:carto_dev_only@localhost:5432/carto_airsoft

# --- Supabase Auth ---------------------------------------------------------
# Tableau de bord Supabase > Settings > API
# URL du projet, ex. https://abcdefgh.supabase.co
SUPABASE_URL=

# Deux modes de vérification des JWT (l'un OU l'autre suffit) :
#  - Projets récents (clés asymétriques) : laisser SUPABASE_JWT_SECRET vide,
#    l'API utilisera le JWKS public dérivé de SUPABASE_URL.
#  - Projets en « legacy JWT secret » (HS256) : coller ici le JWT Secret
#    (Settings > API > JWT Settings).
SUPABASE_JWT_SECRET=

# Audience attendue dans les jetons (défaut Supabase : authenticated)
# SUPABASE_JWT_AUD=authenticated
