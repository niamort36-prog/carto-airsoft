{
  "name": "carto-airsoft",
  "version": "0.1.0",
  "private": true,
  "description": "Application tactique temps réel pour l'airsoft — offline-first, API-first",
  "workspaces": [
    "apps/api",
    "apps/console",
    "packages/*"
  ],
  "scripts": {
    "api:dev": "npm run start:dev --workspace apps/api",
    "api:build": "npm run build --workspace apps/api",
    "api:test": "npm run test --workspace apps/api",
    "console:dev": "npm run dev --workspace apps/console",
    "webapp:dev": "cd apps/mobile && flutter run -d web-server --web-port=5174 --web-hostname=127.0.0.1",
    "webapp:build": "cd apps/mobile && flutter build web --release",
    "console:publish": "node scripts/publish-console.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
